[Unit]
Description=Azentmart Finance AI API
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/azentmart/backend
EnvironmentFile=/etc/azentmart/api.env
ExecStart=/opt/azentmart/backend/.venv/bin/gunicorn app.main:app -k uvicorn.workers.UvicornWorker --workers 2 --timeout 120 --bind 127.0.0.1:8000
Restart=always

[Install]
WantedBy=multi-user.target
